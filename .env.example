# Copia este archivo como .env y llena cada valor. El .env nunca se sube.

# Conexión a la base de datos, desde Supabase: Settings -> Database -> Connection string.
# DATABASE_URL es la del pooler de transacciones, puerto 6543, y es la que usa el sitio.
# DIRECT_URL es la del pooler de sesión, puerto 5432, y solo la usan las migraciones.
# No uses la dirección db.REFERENCIA.supabase.co: solo responde por IPv6.
DATABASE_URL=postgresql://postgres.REFERENCIA:CONTRASENA@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.REFERENCIA:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres

# Cadena al azar con la que se firman las sesiones y la cookie anónima del schüler.
# Genera una nueva con: openssl rand -base64 32
# Si la cambias se cierran todas las sesiones abiertas, que es justo lo que quieres
# si sospechas que alguien se metió.
AUTH_SECRET=

# Almacenamiento de los apuntes y las fotos, desde Supabase: Settings -> API.
# SUPABASE_URL es el Project URL. SUPABASE_SERVICE_KEY es la llave service_role.
# Esa llave da acceso total a la base sin pasar por ninguna regla de permisos:
# va solo aquí, jamás en el código, y nunca en una variable que empiece con NEXT_PUBLIC
# porque esas se mandan al navegador. Hace falta un bucket público llamado lumen.
SUPABASE_URL=https://REFERENCIA.supabase.co
SUPABASE_SERVICE_KEY=

# Con estos dos se crea la cuenta del primer admin al correr npm run db:seed.
# Se usan una sola vez. En cuanto entres, cambia esa contraseña desde el panel
# de usuarios y estos dos valores dejan de importar.
ADMIN_INICIAL_USUARIO=
ADMIN_INICIAL_CONTRASENA=

# Solo en producción, por ejemplo en Vercel, hay que agregar esta con valor true.
# Sin ella el inicio de sesión falla porque Auth.js no confía en el dominio.
# AUTH_TRUST_HOST=true
