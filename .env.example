# Copia este archivo como .env y llena los valores reales.
# El .env nunca se sube al repositorio.

# Supabase -> Settings -> Database -> Connection string
# La primera es la del pooler de transacciones (puerto 6543).
# La segunda es la del pooler de sesión (puerto 5432) y solo la usan las migraciones.
DATABASE_URL=postgresql://postgres.REFERENCIA:CONTRASENA@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.REFERENCIA:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres

# Firma las sesiones y las cookies. Genera una con:
#   openssl rand -base64 32
# Si la cambias, se cierran todas las sesiones abiertas.
AUTH_SECRET=

# Supabase -> Settings -> API
# La llave service_role da acceso total a la base: nunca la pongas en el código
# ni en una variable que empiece con NEXT_PUBLIC.
SUPABASE_URL=https://REFERENCIA.supabase.co
SUPABASE_SERVICE_KEY=

# Solo se usan la primera vez, al crear la cuenta del primer admin con
# npm run db:seed. Después de entrar, cambia esa contraseña desde el panel.
ADMIN_INICIAL_USUARIO=
ADMIN_INICIAL_CONTRASENA=

# En producción (Vercel) hay que agregar además:
# AUTH_TRUST_HOST=true
